{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProseRiskReview",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "chapter",
    "generated_at",
    "status",
    "official_chapter",
    "official_brief",
    "input_hashes",
    "categories",
    "metrics",
    "blockers",
    "warnings"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["CLEAR", "WARNING", "BLOCKED", "ACCEPTED_BY_HUMAN", "NOT_READY"] },
    "official_chapter": { "type": "object" },
    "official_brief": { "type": "object" },
    "input_hashes": { "type": "array" },
    "categories": { "type": "object" },
    "metrics": { "type": "object" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "human_acceptance": { "type": ["object", "null"] }
  }
}
