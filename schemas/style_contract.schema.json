{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StyleContract",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "narration_person",
    "narration_distance",
    "tense_policy",
    "sentence_rhythm",
    "paragraph_density",
    "dialogue_ratio",
    "interiority_ratio",
    "action_style",
    "exposition_policy",
    "emotional_tone",
    "humor_level",
    "payoff_style",
    "metaphor_sources",
    "forbidden_styles",
    "reference_style_policy",
    "imitation_policy",
    "writes_canon",
    "writes_chapters",
    "writes_event_ledger"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["DRAFT", "CANDIDATE", "READY"] },
    "idea_id": { "type": "string" },
    "created_at": { "type": "string" },
    "landed_at": { "type": "string" },
    "landed_from": { "type": "string" },
    "narration_person": { "type": "string" },
    "narration_distance": { "type": "string" },
    "tense_policy": { "type": "string" },
    "sentence_rhythm": { "type": "string" },
    "paragraph_density": { "type": "string" },
    "dialogue_ratio": { "type": "string" },
    "interiority_ratio": { "type": "string" },
    "action_style": { "type": "string" },
    "exposition_policy": { "type": "string" },
    "emotional_tone": { "type": "string" },
    "humor_level": { "type": "string" },
    "payoff_style": { "type": "array", "items": { "type": "string" } },
    "metaphor_sources": { "type": "array", "items": { "type": "string" } },
    "forbidden_styles": { "type": "array", "items": { "type": "string" } },
    "reference_style_policy": { "type": "object" },
    "imitation_policy": { "type": "string" },
    "style_profile_policy": { "type": "string" },
    "writes_canon": { "const": false },
    "writes_chapters": { "const": false },
    "writes_event_ledger": { "const": false }
  }
}
