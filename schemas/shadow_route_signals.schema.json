{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadowRouteSignals",
  "type": "object",
  "required": ["schema_version", "shadow_version", "artifact", "chapter", "generated_at", "status", "source_boundary", "source_refs", "route", "route_upper_bound_only", "can_downgrade_route", "must_not_skip_ship_evidence", "reasons", "confidence", "stale"],
  "properties": {
    "schema_version": { "type": "integer" },
    "shadow_version": { "type": "integer" },
    "artifact": { "const": "route_signals" },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["READY", "BLOCKED", "WARNING"] },
    "source_boundary": { "const": "shadow_advisory_not_fact_source" },
    "source_refs": { "type": "array", "items": { "type": "object" } },
    "route": { "enum": ["fast", "normal", "heavy", "gate"] },
    "route_upper_bound_only": { "type": "boolean" },
    "can_downgrade_route": { "type": "boolean" },
    "must_not_skip_ship_evidence": { "type": "boolean" },
    "reasons": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "shadow_inputs": { "type": "object" },
    "confidence": { "type": "number" },
    "stale": { "type": "boolean" }
  }
}
