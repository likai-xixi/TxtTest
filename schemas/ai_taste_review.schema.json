{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AiTasteReview",
  "type": "object",
  "required": ["schema_version", "chapter", "generated_at", "status", "official_chapter", "categories", "blockers", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string" },
    "status": { "enum": ["CLEAR", "BLOCKED", "ACCEPTED_BY_HUMAN"] },
    "official_chapter": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "metrics": { "type": "object" },
    "categories": {
      "type": "object",
      "required": ["show_dont_tell", "rhythm_disorder", "emotional_risk", "gray_motive", "dialogue_agenda", "detail_economy", "consequence_integrity"],
      "additionalProperties": {
        "type": "object",
        "required": ["status", "severity", "evidence_quotes", "issue", "revision_actions"],
        "properties": {
          "status": { "enum": ["CLEAR", "BLOCKED", "ACCEPTED_BY_HUMAN"] },
          "severity": { "enum": ["P0", "P1", "P2", "P3"] },
          "evidence_quotes": { "type": "array", "items": { "type": "string" } },
          "issue": { "type": "string" },
          "revision_actions": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "human_acceptance": { "type": ["object", "null"] }
  }
}
