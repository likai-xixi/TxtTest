{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProtagonistProgression",
  "type": "object",
  "required": ["schema_version", "generated_at", "entries"],
  "properties": {
    "schema_version": { "type": "integer" },
    "generated_at": { "type": "string" },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter"],
        "properties": {
          "chapter": { "type": "string" },
          "power_delta": { "type": "string" },
          "status_delta": { "type": "string" },
          "knowledge_delta": { "type": "string" },
          "relationship_delta": { "type": "string" },
          "goldfinger_delta": { "type": "string" },
          "reader_reward": { "type": "string" }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}

