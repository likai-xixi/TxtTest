{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AgentReviewManifest",
  "type": "object",
  "required": ["schema_version", "idea_id", "recorded_at", "inputs", "reviews"],
  "properties": {
    "schema_version": { "const": 1 },
    "idea_id": { "type": "string" },
    "recorded_at": { "type": "string" },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "reviews": {
      "type": "object",
      "required": ["product_founder", "technical_lead", "qa_release"],
      "properties": {
        "product_founder": {
          "type": "object",
          "required": ["role", "agent_id", "path", "sha256", "completed_at", "agent_run"],
          "properties": {
            "role": { "type": "string" },
            "agent_id": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "completed_at": { "type": "string" },
            "agent_run": { "type": "object" }
          }
        },
        "technical_lead": {
          "type": "object",
          "required": ["role", "agent_id", "path", "sha256", "completed_at", "agent_run"],
          "properties": {
            "role": { "type": "string" },
            "agent_id": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "completed_at": { "type": "string" },
            "agent_run": { "type": "object" }
          }
        },
        "qa_release": {
          "type": "object",
          "required": ["role", "agent_id", "path", "sha256", "completed_at", "agent_run"],
          "properties": {
            "role": { "type": "string" },
            "agent_id": { "type": "string", "minLength": 1 },
            "path": { "type": "string" },
            "sha256": { "type": "string" },
            "completed_at": { "type": "string" },
            "agent_run": { "type": "object" }
          }
        }
      }
    }
  }
}
