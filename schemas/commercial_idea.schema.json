{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CommercialIdea",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "idea_id",
    "generated_at",
    "status",
    "target_platform",
    "target_reader",
    "genre_lane",
    "ranking_goal",
    "three_day_retention_design",
    "paid_conversion_design",
    "update_cadence",
    "expected_length",
    "core_satisfactions",
    "emotional_hook",
    "first_three_chapter_validation_points",
    "differentiation_one_liner",
    "what_not_to_write",
    "copyright_similarity_risk_statement",
    "no_imitation_attestation",
    "writes_canon",
    "writes_event_ledger",
    "writes_context_pack",
    "writes_brief"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "idea_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["READY", "WARNING", "BLOCKED"] },
    "target_platform": { "type": "string" },
    "target_reader": { "type": "string" },
    "genre_lane": { "type": "string" },
    "ranking_goal": { "type": "string" },
    "three_day_retention_design": { "type": "string" },
    "paid_conversion_design": { "type": "string" },
    "update_cadence": { "type": "string" },
    "expected_length": { "type": "string" },
    "core_satisfactions": { "type": "array", "items": { "type": "string" } },
    "emotional_hook": { "type": "string" },
    "first_three_chapter_validation_points": { "type": "array", "items": { "type": "string" } },
    "differentiation_one_liner": { "type": "string" },
    "what_not_to_write": { "type": "array", "items": { "type": "string" } },
    "copyright_similarity_risk_statement": { "type": "string" },
    "no_imitation_attestation": { "type": "string" },
    "writes_canon": { "type": "boolean", "const": false },
    "writes_event_ledger": { "type": "boolean", "const": false },
    "writes_context_pack": { "type": "boolean", "const": false },
    "writes_brief": { "type": "boolean", "const": false }
  }
}
