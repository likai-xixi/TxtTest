{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexAntiAiReviewManifest",
  "type": "object",
  "required": ["schema_version", "chapter", "reviewer", "generated_at", "prompt", "inputs", "forbidden_inputs", "outputs_expected", "isolation_attestation"],
  "properties": {
    "schema_version": { "const": 1 },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "reviewer": { "const": "codex_anti_ai_subagent" },
    "generated_at": { "type": "string" },
    "prompt": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string" },
          "sha256": { "type": "string" }
        }
      }
    },
    "forbidden_inputs": { "type": "array", "items": { "type": "string" } },
    "outputs_expected": { "type": "array", "items": { "type": "string" } },
    "isolation_attestation": { "type": "string" }
  }
}
