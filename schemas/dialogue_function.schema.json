{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DialogueFunctionReview",
  "type": "object",
  "required": ["schema_version", "chapter", "generated_at", "status", "official_chapter", "summary", "samples", "blockers", "warnings"],
  "properties": {
    "schema_version": { "const": 1 },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string" },
    "status": { "enum": ["CLEAR", "BLOCKED", "ACCEPTED_BY_HUMAN"] },
    "official_chapter": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["dialogue_line_count", "sample_count", "pure_theme_statement_count", "pure_theme_statement_ratio"]
    },
    "samples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["evidence_quote", "speaker", "function", "character_goal", "subtext_or_hidden_agenda", "consequence_or_power_shift", "status"],
        "properties": {
          "evidence_quote": { "type": "string" },
          "speaker": { "type": "string" },
          "function": { "type": "string" },
          "character_goal": { "type": "string" },
          "subtext_or_hidden_agenda": { "type": "string" },
          "consequence_or_power_shift": { "type": "string" },
          "status": { "enum": ["CLEAR", "BLOCKED", "ACCEPTED_BY_HUMAN"] }
        }
      }
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "human_acceptance": { "type": ["object", "null"] }
  }
}
