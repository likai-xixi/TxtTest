{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventLedgerEntry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "chapter",
    "type",
    "fact",
    "evidence_quote",
    "consequence",
    "verified_by"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "pattern": "^v\\d{2}_c\\d{3}_e\\d{3}$"
    },
    "chapter": {
      "type": "string",
      "pattern": "^v\\d{2}_c\\d{3}$"
    },
    "type": {
      "type": "string",
      "enum": [
        "character_decision",
        "character_state_change",
        "relationship_change",
        "world_fact",
        "rule_reveal",
        "thread_opened",
        "thread_advanced",
        "thread_paid_off",
        "location_change",
        "object_change",
        "chapter_anchor",
        "correction"
      ]
    },
    "fact": {
      "type": "string",
      "minLength": 1
    },
    "evidence_quote": {
      "type": "string",
      "minLength": 1
    },
    "consequence": {
      "type": "string",
      "minLength": 1
    },
    "verified_by": {
      "type": "string",
      "const": "human"
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "thread_id": {
      "type": "string",
      "minLength": 1
    },
    "importance": {
      "type": "string",
      "enum": ["P0", "P1", "P2", "P3"]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "end_time",
        "end_location",
        "present_characters",
        "protagonist_state",
        "carried_items",
        "unfinished_action",
        "next_required_continuity"
      ],
      "properties": {
        "end_time": { "type": "string", "minLength": 1 },
        "end_location": { "type": "string", "minLength": 1 },
        "present_characters": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "protagonist_state": { "type": "string", "minLength": 1 },
        "carried_items": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "unfinished_action": { "type": "string", "minLength": 1 },
        "next_required_continuity": { "type": "string", "minLength": 1 }
      }
    }
  }
}
