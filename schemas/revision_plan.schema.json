{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Revision Plan",
  "type": "object",
  "required": ["schema_version", "chapter", "generated_at", "status", "official_chapter", "input_hashes", "must_fix", "should_fix", "human_acceptance_allowed"],
  "properties": {
    "schema_version": {"type": "integer"},
    "chapter": {"type": "string"},
    "generated_at": {"type": "string"},
    "status": {"type": "string"},
    "official_chapter": {"type": "object"},
    "input_hashes": {"type": "array"},
    "must_fix": {"type": "array"},
    "should_fix": {"type": "array"},
    "human_acceptance_allowed": {"type": "array"},
    "must_preserve": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "highlight_id": {"type": "string"},
          "type": {"type": "string"},
          "quote": {"type": "string"},
          "quote_sha256": {"type": "string"},
          "protection_level": {"type": "string"},
          "source": {"type": "string"}
        }
      }
    },
    "highlight_revisions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "highlight_id": {"type": "string"},
          "action": {"type": "string"},
          "human_override_reason": {"type": "string"}
        }
      }
    }
  },
  "additionalProperties": false
}
