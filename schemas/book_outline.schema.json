{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BookOutline",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "book_title_working",
    "genre_lane",
    "target_reader",
    "target_word_count",
    "word_count_range",
    "estimated_volumes",
    "chapter_word_count_range",
    "one_sentence_promise",
    "main_story_question",
    "protagonist_long_term_desire",
    "core_opposition",
    "worldview_reveal_strategy",
    "commercial_hook",
    "emotional_hook",
    "differentiation_angle",
    "volume_plan",
    "major_character_arcs",
    "main_thread_plan",
    "relationship_thread_plan",
    "power_or_rule_progression",
    "risk_and_cost_progression",
    "first_3_chapters_validation",
    "first_10_chapters_validation",
    "gate_plan",
    "ending_direction",
    "red_lines",
    "open_questions",
    "anti_imitation_attestation",
    "writes_canon",
    "writes_chapters",
    "writes_event_ledger"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["DRAFT", "CANDIDATE", "READY"] },
    "idea_id": { "type": "string" },
    "created_at": { "type": "string" },
    "landed_at": { "type": "string" },
    "landed_from": { "type": "string" },
    "core_setting_freeze_ref": { "type": "object" },
    "book_title_working": { "type": "string" },
    "genre_lane": { "type": "string" },
    "target_reader": { "type": "string" },
    "target_word_count": { "type": "integer" },
    "word_count_range": { "type": "object" },
    "estimated_volumes": { "type": "integer" },
    "chapter_word_count_range": { "type": "object" },
    "one_sentence_promise": { "type": "string" },
    "main_story_question": { "type": "string" },
    "protagonist_long_term_desire": { "type": "string" },
    "core_opposition": { "type": "string" },
    "worldview_reveal_strategy": { "type": "string" },
    "commercial_hook": { "type": "string" },
    "emotional_hook": { "type": "string" },
    "differentiation_angle": { "type": "string" },
    "volume_plan": { "type": "array", "items": { "type": "object" } },
    "major_character_arcs": { "type": "array", "items": { "type": "string" } },
    "main_thread_plan": { "type": "array", "items": { "type": "string" } },
    "relationship_thread_plan": { "type": "array", "items": { "type": "string" } },
    "power_or_rule_progression": { "type": "array", "items": { "type": "string" } },
    "risk_and_cost_progression": { "type": "array", "items": { "type": "string" } },
    "first_3_chapters_validation": { "type": "array", "items": { "type": "string" } },
    "first_10_chapters_validation": { "type": "array", "items": { "type": "string" } },
    "gate_plan": { "type": "object" },
    "ending_direction": { "type": "string" },
    "red_lines": { "type": "array", "items": { "type": "string" } },
    "open_questions": { "type": "array", "items": { "type": "string" } },
    "anti_imitation_attestation": { "type": "string" },
    "core_setting_freeze_conflicts": { "type": "array", "items": { "type": "string" } },
    "writes_canon": { "const": false },
    "writes_chapters": { "const": false },
    "writes_event_ledger": { "const": false }
  }
}
