{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DeepSeekStyleReview",
  "type": "object",
  "required": ["schema_version", "chapter", "generated_at", "model", "status", "official_chapter", "inputs", "findings", "warnings", "blockers", "summary"],
  "properties": {
    "schema_version": { "const": 1 },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string" },
    "model": { "type": "string" },
    "status": { "enum": ["CLEAR", "WARNING", "BLOCKED", "ACCEPTED_BY_HUMAN"] },
    "action": { "type": "string" },
    "official_chapter": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string" }
      }
    },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "findings": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "summary": { "type": "string" }
  }
}
