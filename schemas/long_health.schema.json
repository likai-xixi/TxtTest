{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LongHealth",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "generated_at",
    "status",
    "through",
    "chapters",
    "source_event_ledger",
    "source_reader_promise",
    "rolling_input_refs",
    "events",
    "counts_by_type",
    "reader_experience_ledgers",
    "context_health_window",
    "context_health_blockers",
    "context_health_warnings",
    "rolling_blockers",
    "rolling_warnings",
    "risk_flags"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["READY", "WARNING", "BLOCKED"] },
    "through": { "type": "string", "pattern": "^v\\d{2}_c\\d{3}$" },
    "chapters": { "type": "integer" },
    "source_event_ledger": { "type": "object" },
    "source_reader_promise": { "type": "object" },
    "rolling_input_refs": { "type": "array" },
    "events": { "type": "integer" },
    "counts_by_type": { "type": "object" },
    "unresolved_thread_count": { "type": "integer" },
    "oldest_unresolved_thread_age": { "type": "integer" },
    "average_payoff_interval": { "type": ["number", "null"] },
    "agency_density": { "type": "number" },
    "setting_debt_index": { "type": "integer" },
    "gate_risks": { "type": "array", "items": { "type": "string" } },
    "reader_experience_ledgers": { "type": "object" },
    "context_health_window": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter", "context_quality", "status"],
        "properties": {
          "chapter": { "type": "string" },
          "context_quality": {
            "type": "object",
            "required": ["path", "exists", "sha256"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "exists": { "type": "boolean" },
              "sha256": { "type": "string" }
            }
          },
          "status": { "type": "string" },
          "context_health_status": { "type": "string" },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "blockers": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "context_health_blockers": { "type": "array", "items": { "type": "string" } },
    "context_health_warnings": { "type": "array", "items": { "type": "string" } },
    "rolling_blockers": { "type": "array", "items": { "type": "string" } },
    "rolling_warnings": { "type": "array", "items": { "type": "string" } },
    "risk_flags": { "type": "array", "items": { "type": "string" } }
  }
}
