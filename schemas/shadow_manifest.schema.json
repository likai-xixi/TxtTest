{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ShadowManifest",
  "type": "object",
  "required": ["schema_version", "shadow_version", "artifact", "chapter", "generated_at", "status", "source_boundary", "source_refs", "artifacts", "artifact_statuses", "route"],
  "properties": {
    "schema_version": { "type": "integer" },
    "shadow_version": { "type": "integer" },
    "artifact": { "const": "manifest" },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "enum": ["READY", "BLOCKED", "WARNING"] },
    "source_boundary": { "const": "shadow_advisory_not_fact_source" },
    "source_refs": { "type": "array" },
    "artifacts": { "type": "object" },
    "artifact_statuses": { "type": "object" },
    "route": { "enum": ["fast", "normal", "heavy", "gate"] },
    "can_downgrade_route": { "type": "boolean" },
    "can_satisfy_ship_without_chapter_evidence": { "type": "boolean" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
