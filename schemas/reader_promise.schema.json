{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReaderPromise",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "primary_genre",
    "secondary_genre",
    "target_reader",
    "platform_expectation",
    "core_hook",
    "main_reader_rewards",
    "non_promises",
    "first_chapter_must_deliver",
    "second_chapter_must_escalate",
    "third_chapter_must_hook",
    "three_chapter_main_question",
    "three_chapter_protagonist_specialness",
    "per_chapter_must_have",
    "per_chapter_must_not_only_have",
    "ending_hook_priority",
    "reward_mix",
    "genre_mismatch_red_lines",
    "source_boundary"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "status": { "enum": ["DRAFT", "READY"] },
    "primary_genre": { "type": "string" },
    "secondary_genre": { "type": "string" },
    "target_reader": { "type": "string" },
    "platform_expectation": { "type": "string" },
    "core_hook": { "type": "string" },
    "main_reader_rewards": { "type": "array", "items": { "type": "string" } },
    "non_promises": { "type": "array", "items": { "type": "string" } },
    "first_chapter_must_deliver": { "type": "string" },
    "second_chapter_must_escalate": { "type": "string" },
    "third_chapter_must_hook": { "type": "string" },
    "three_chapter_main_question": { "type": "string" },
    "three_chapter_protagonist_specialness": { "type": "string" },
    "per_chapter_must_have": { "type": "array", "items": { "type": "string" } },
    "per_chapter_must_not_only_have": { "type": "array", "items": { "type": "string" } },
    "ending_hook_priority": { "type": "array", "items": { "type": "string" } },
    "reward_mix": { "type": "object" },
    "genre_mismatch_red_lines": { "type": "array", "items": { "type": "string" } },
    "source_boundary": { "const": "instruction_only_not_fact_source" }
  }
}

