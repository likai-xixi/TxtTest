{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReaderPromise",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "status",
    "primary_genre",
    "secondary_genre",
    "target_reader",
    "platform_expectation",
    "genre_profile",
    "core_hook",
    "core_sell_point",
    "core_mechanism_name",
    "allowed_low_drama_carriers",
    "main_reader_rewards",
    "non_promises",
    "first_chapter_must_deliver",
    "second_chapter_must_escalate",
    "third_chapter_must_hook",
    "three_chapter_main_question",
    "three_chapter_protagonist_specialness",
    "per_chapter_must_have",
    "per_chapter_must_not_only_have",
    "ending_hook_priority",
    "reward_mix",
    "positive_promises",
    "negative_failure_modes",
    "release_valve_policy",
    "protagonist_agency_policy",
    "information_clarity_policy",
    "language_experience_policy",
    "structural_efficiency_policy",
    "reader_reward_intensity_policy",
    "genre_mismatch_red_lines",
    "source_boundary"
  ],
  "properties": {
    "schema_version": { "type": "integer" },
    "status": { "enum": ["DRAFT", "READY"] },
    "primary_genre": { "type": "string" },
    "secondary_genre": { "type": "string" },
    "target_reader": { "type": "string" },
    "platform_expectation": { "type": "string" },
    "genre_profile": { "type": "string" },
    "core_hook": { "type": "string" },
    "core_sell_point": { "type": "string" },
    "core_mechanism_name": { "type": "string" },
    "allowed_low_drama_carriers": { "type": "array", "items": { "type": "string" } },
    "main_reader_rewards": { "type": "array", "items": { "type": "string" } },
    "non_promises": { "type": "array", "items": { "type": "string" } },
    "first_chapter_must_deliver": { "type": "string" },
    "second_chapter_must_escalate": { "type": "string" },
    "third_chapter_must_hook": { "type": "string" },
    "three_chapter_main_question": { "type": "string" },
    "three_chapter_protagonist_specialness": { "type": "string" },
    "per_chapter_must_have": { "type": "array", "items": { "type": "string" } },
    "per_chapter_must_not_only_have": { "type": "array", "items": { "type": "string" } },
    "ending_hook_priority": { "type": "array", "items": { "type": "string" } },
    "reward_mix": { "type": "object" },
    "positive_promises": { "type": "array", "items": { "type": "string" } },
    "negative_failure_modes": {
      "type": "object",
      "required": [
        "red_lines",
        "no_release_max_run",
        "no_payoff_max_run",
        "open_without_payoff_max_run",
        "passive_protagonist_max_run",
        "explanation_only_max_run",
        "repeated_shape_max_run",
        "low_efficiency_window_chapters",
        "low_efficiency_max_count"
      ],
      "properties": {
        "red_lines": { "type": "array", "items": { "type": "string" } },
        "no_release_max_run": { "type": "integer" },
        "no_payoff_max_run": { "type": "integer" },
        "open_without_payoff_max_run": { "type": "integer" },
        "passive_protagonist_max_run": { "type": "integer" },
        "explanation_only_max_run": { "type": "integer" },
        "repeated_shape_max_run": { "type": "integer" },
        "low_efficiency_window_chapters": { "type": "integer" },
        "low_efficiency_max_count": { "type": "integer" }
      }
    },
    "release_valve_policy": {
      "type": "object",
      "required": [
        "max_high_pressure_without_release",
        "minimum_release_types",
        "per_three_chapters_must_include_release",
        "rationale"
      ],
      "properties": {
        "max_high_pressure_without_release": { "type": "integer" },
        "minimum_release_types": { "type": "array", "items": { "type": "string" } },
        "per_three_chapters_must_include_release": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "protagonist_agency_policy": {
      "type": "object",
      "required": [
        "requires_active_goal",
        "requires_active_action",
        "requires_cost_or_consequence",
        "requires_state_change",
        "requires_desire_or_principle",
        "rationale"
      ],
      "properties": {
        "requires_active_goal": { "type": "boolean" },
        "requires_active_action": { "type": "boolean" },
        "requires_cost_or_consequence": { "type": "boolean" },
        "requires_state_change": { "type": "boolean" },
        "requires_desire_or_principle": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "information_clarity_policy": {
      "type": "object",
      "required": [
        "max_consecutive_setup_only_chapters",
        "require_scene_test_for_world_rule",
        "forbid_explanation_only_worldbuilding",
        "rationale"
      ],
      "properties": {
        "max_consecutive_setup_only_chapters": { "type": "integer" },
        "require_scene_test_for_world_rule": { "type": "boolean" },
        "forbid_explanation_only_worldbuilding": { "type": "boolean" },
        "rationale": { "type": "string" }
      }
    },
    "language_experience_policy": {
      "type": "object",
      "required": [
        "forbid_summary_voice",
        "require_memorable_line_or_detail",
        "max_explanation_paragraphs_without_scene",
        "rationale"
      ],
      "properties": {
        "forbid_summary_voice": { "type": "boolean" },
        "require_memorable_line_or_detail": { "type": "boolean" },
        "max_explanation_paragraphs_without_scene": { "type": "integer" },
        "rationale": { "type": "string" }
      }
    },
    "structural_efficiency_policy": {
      "type": "object",
      "required": [
        "min_effective_progress_per_chapter",
        "max_words_without_state_change",
        "max_low_progress_window_count",
        "window_chapters",
        "rationale"
      ],
      "properties": {
        "min_effective_progress_per_chapter": { "type": "string" },
        "max_words_without_state_change": { "type": "integer" },
        "max_low_progress_window_count": { "type": "integer" },
        "window_chapters": { "type": "integer" },
        "rationale": { "type": "string" }
      }
    },
    "reader_reward_intensity_policy": {
      "type": "object",
      "required": [
        "opening_chapter_count",
        "opening_intensity_by_chapter",
        "default_chapter_intensity",
        "allowed_chapter_overrides",
        "rationale"
      ],
      "properties": {
        "opening_chapter_count": { "type": "integer" },
        "opening_intensity_by_chapter": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "default_chapter_intensity": { "type": "string" },
        "allowed_chapter_overrides": { "type": ["object", "array"] },
        "rationale": { "type": "string" }
      }
    },
    "genre_mismatch_red_lines": { "type": "array", "items": { "type": "string" } },
    "source_boundary": { "const": "instruction_only_not_fact_source" }
  }
}
