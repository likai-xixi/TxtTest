{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MarketScan",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "idea_id",
    "generated_at",
    "status",
    "target_platform",
    "genre_lane",
    "target_reader",
    "reader_expectations",
    "common_hooks",
    "saturation_risks",
    "differentiation_angle",
    "copyright_risk",
    "no_imitation_attestation",
    "writes_canon",
    "writes_event_ledger",
    "writes_context_pack",
    "writes_brief"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "idea_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["READY", "WARNING", "BLOCKED"] },
    "target_platform": { "type": "string" },
    "genre_lane": { "type": "string" },
    "target_reader": { "type": "string" },
    "reader_expectations": { "type": "array", "items": { "type": "string" } },
    "common_hooks": { "type": "array", "items": { "type": "string" } },
    "saturation_risks": { "type": "array", "items": { "type": "string" } },
    "differentiation_angle": { "type": "string" },
    "copyright_risk": { "type": "string" },
    "no_imitation_attestation": { "type": "string" },
    "writes_canon": { "type": "boolean", "const": false },
    "writes_event_ledger": { "type": "boolean", "const": false },
    "writes_context_pack": { "type": "boolean", "const": false },
    "writes_brief": { "type": "boolean", "const": false }
  }
}
