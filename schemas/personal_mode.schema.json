{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProjectMode",
  "type": "object",
  "required": ["mode", "scope", "ship_gates", "literary_reviews", "reader_feedback", "infrastructure"],
  "properties": {
    "mode": { "enum": ["personal_noncommercial", "commercial_serial"] },
    "scope": {
      "type": "object",
      "required": [
        "main_goal",
        "commercial_advisory_enabled",
        "platform_adaptation_enabled",
        "monetization_optimization_enabled",
        "ranking_optimization_enabled",
        "paid_conversion_enabled",
        "retention_optimization_enabled",
        "treat_legacy_commercial_tools_as_main_flow"
      ],
      "properties": {
        "main_goal": { "enum": ["personal_writing_pilot", "commercial_serial_monetization"] },
        "commercial_advisory_enabled": { "type": "boolean" },
        "platform_adaptation_enabled": { "type": "boolean" },
        "monetization_optimization_enabled": { "type": "boolean" },
        "ranking_optimization_enabled": { "type": "boolean" },
        "paid_conversion_enabled": { "type": "boolean" },
        "retention_optimization_enabled": { "type": "boolean" },
        "treat_legacy_commercial_tools_as_main_flow": { "type": "boolean" }
      }
    },
    "ship_gates": {
      "type": "object",
      "required": ["always_required", "allow_route_to_skip_ship_gates"],
      "properties": {
        "always_required": { "const": true },
        "allow_route_to_skip_ship_gates": { "const": false }
      }
    },
    "literary_reviews": {
      "type": "object",
      "required": ["default_blocking", "human_flavor_default", "highlights_default", "ai_taste_default"],
      "properties": {
        "default_blocking": { "const": false },
        "human_flavor_default": { "enum": ["warning"] },
        "highlights_default": { "enum": ["advisory"] },
        "ai_taste_default": { "enum": ["warning"] }
      }
    },
    "reader_feedback": {
      "type": "object",
      "required": ["require_real_reader", "allow_self_review", "allow_simulated_reader", "simulated_reader_must_be_labeled"],
      "properties": {
        "require_real_reader": { "const": false },
        "allow_self_review": { "const": true },
        "allow_simulated_reader": { "const": true },
        "simulated_reader_must_be_labeled": { "const": true }
      }
    },
    "infrastructure": {
      "type": "object",
      "required": ["sqlite_enabled", "vector_memory_enabled", "knowledge_graph_enabled"],
      "properties": {
        "sqlite_enabled": { "const": false },
        "vector_memory_enabled": { "const": false },
        "knowledge_graph_enabled": { "const": false }
      }
    }
  }
}
