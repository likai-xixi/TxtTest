{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HumanFlavorReview",
  "type": "object",
  "required": ["schema_version", "chapter", "generated_at", "status", "official_chapter", "official_brief", "input_hashes", "signals", "evidence_quotes", "warnings", "blockers"],
  "properties": {
    "schema_version": { "type": "integer" },
    "chapter": { "type": "string", "pattern": "^v[0-9]{2}_c[0-9]{3}$" },
    "generated_at": { "type": "string" },
    "status": { "enum": ["CLEAR", "WARNING", "NOT_READY", "ACCEPTED_BY_HUMAN"] },
    "official_chapter": { "type": "object" },
    "official_brief": { "type": "object" },
    "input_hashes": { "type": "array" },
    "signals": { "type": "object" },
    "window": { "type": "object" },
    "evidence_quotes": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "blockers": { "type": "array", "items": { "type": "string" } }
  }
}
